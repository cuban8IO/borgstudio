<?xml version="1.0" encoding="utf-8"?>
<!--
  Use nuget.org only. <clear /> drops sources inherited from the machine-wide NuGet.Config
  (e.g. authenticated company feeds), so restores behave the same locally and in CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
