<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:BorgStudio.App.Resources"
        x:Class="BorgStudio.App.Views.PassphraseWindow"
        Title="{x:Static res:Strings.PassphrasePromptTitle}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="PassphraseBox" PasswordChar="•" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Static res:Strings.Ok}" Classes="accent" IsDefault="True" Click="Ok_Click" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>

</Window>
