<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BorgStudio.App.ViewModels"
        xmlns:views="using:BorgStudio.App.Views"
        xmlns:res="using:BorgStudio.App.Resources"
        xmlns:sys="using:System"
        x:Class="BorgStudio.App.Views.RepositoryEditorWindow"
        x:DataType="vm:RepositoryEditorViewModel"
        Title="{Binding Title}"
        Width="600" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="20">

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Content="{x:Static res:Strings.EditorBack}" Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}" />
            <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Content="{x:Static res:Strings.EditorNext}" Command="{Binding NextCommand}" Classes="accent"
                    IsVisible="{Binding IsProviderPage}" IsDefault="{Binding IsProviderPage}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Classes="accent"
                    IsVisible="{Binding IsDetailsPage}" IsDefault="{Binding IsDetailsPage}" />
        </StackPanel>

        <!-- Progress and errors -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <Panel IsVisible="{Binding IsBusy}">
                <views:ProgressPanel DataContext="{Binding Progress}" />
            </Panel>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForeground}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Panel>
            <!-- Page 1: provider -->
            <DockPanel IsVisible="{Binding IsProviderPage}">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.EditorChooseProvider}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderOptionViewModel">
                            <StackPanel Margin="4,6" Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Page 2: details -->
            <ScrollViewer IsVisible="{Binding IsDetailsPage}">
                <StackPanel Spacing="14" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SelectedProvider.DisplayName}" FontSize="16" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.EditorName}" />
                        <TextBox Text="{Binding Name}" />
                        <TextBlock Text="{x:Static res:Strings.EditorNameHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FieldViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Label}" IsVisible="{Binding !IsToggle}" />
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsVisible="{Binding IsToggle}" />
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsTextInput}">
                                        <TextBox Text="{Binding Value}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" IsVisible="{Binding IsFolder}"
                                                Content="{x:Static res:Strings.EditorBrowse}" Click="BrowseFolder_Click" />
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                              IsVisible="{Binding IsChoice}" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}"
                                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border IsVisible="{Binding ShowConvertToUsb}" Background="{StaticResource BpSurface2Brush}" BorderBrush="{StaticResource BpLineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Static res:Strings.EditorConvertToUsbHint}" TextWrapping="Wrap" />
                            <Button Content="{x:Static res:Strings.EditorConvertToUsb}" Command="{Binding ConvertToUsbCommand}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.EditorConvertedToUsb}" IsVisible="{Binding ConvertedToUsb}"
                               Foreground="{StaticResource BpGreenBrush}" TextWrapping="Wrap" />

                    <StackPanel Spacing="4" IsVisible="{Binding ShowModeChoice}">
                        <RadioButton GroupName="Mode" IsChecked="{Binding !CreateNew}"
                                     Content="{x:Static res:Strings.EditorModeConnect}" />
                        <RadioButton GroupName="Mode" IsChecked="{Binding CreateNew}"
                                     Content="{x:Static res:Strings.EditorModeCreate}" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding ShowEncryption}">
                        <TextBlock Text="{x:Static res:Strings.EditorEncryption}" />
                        <ComboBox ItemsSource="{Binding EncryptionOptions}" SelectedItem="{Binding SelectedEncryption}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding EncryptionHint}" IsVisible="{Binding EncryptionHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorForeground}" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding UsesPassphrase}">
                        <TextBlock Text="{x:Static res:Strings.EditorPassphrase}" />
                        <TextBox Text="{Binding Passphrase}" PasswordChar="•" />
                        <TextBlock Text="{x:Static res:Strings.EditorPassphraseConfirmation}"
                                   IsVisible="{Binding ShowPassphraseConfirmation}" Margin="0,6,0,0" />
                        <TextBox Text="{Binding PassphraseConfirmation}" PasswordChar="•"
                                 IsVisible="{Binding ShowPassphraseConfirmation}" />
                        <TextBlock Text="{Binding PassphraseHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static res:Strings.EditorPassphraseStorage}" Margin="0,6,0,0" />
                        <RadioButton GroupName="PassphraseStorage" IsChecked="{Binding StorageVault}">
                            <TextBlock Text="{x:Static res:Strings.EditorStorageVault}" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton GroupName="PassphraseStorage" IsChecked="{Binding StorageKeychain}"
                                     IsEnabled="{Binding CanUseKeychain}">
                            <TextBlock Text="{x:Static res:Strings.EditorStorageKeychain}" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton GroupName="PassphraseStorage" IsChecked="{Binding StorageAsk}"
                                     Content="{x:Static res:Strings.EditorStorageAsk}" />
                        <TextBlock Text="{x:Static res:Strings.EditorKeychainUnavailable}" IsVisible="{Binding KeychainUnavailable}"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- SSH login -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsSsh}">
                        <TextBlock Text="{x:Static res:Strings.EditorSshLogin}" FontWeight="SemiBold" />
                        <RadioButton GroupName="SshKey" IsChecked="{Binding KeyChoiceKeep}" IsVisible="{Binding ShowKeepKeyOption}"
                                     Content="{x:Static res:Strings.EditorKeyKeep}" />
                        <RadioButton GroupName="SshKey" IsChecked="{Binding KeyChoiceGenerate}">
                            <TextBlock Text="{x:Static res:Strings.EditorKeyGenerate}" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton GroupName="SshKey" IsChecked="{Binding KeyChoiceExisting}">
                            <TextBlock Text="{x:Static res:Strings.EditorKeyExisting}" TextWrapping="Wrap" />
                        </RadioButton>
                        <StackPanel Spacing="4" Margin="28,0,0,4" IsVisible="{Binding KeyChoiceExisting}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedKey}"
                                          HorizontalAlignment="Stretch" IsVisible="{Binding !HasNoKeys}" />
                                <TextBlock Text="{x:Static res:Strings.EditorNoKeys}" TextWrapping="Wrap" Opacity="0.7"
                                           VerticalAlignment="Center" IsVisible="{Binding HasNoKeys}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="{x:Static res:Strings.KeysImport}"
                                        Command="{Binding ImportKeyCommand}" />
                            </Grid>
                            <CheckBox IsChecked="{Binding InstallExistingKey}" Margin="0,4,0,0">
                                <TextBlock Text="{x:Static res:Strings.EditorInstallExistingKey}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>

                        <!-- Installing a key on the server: a generated one always, one from the list on request. -->
                        <StackPanel Spacing="4" Margin="28,0,0,4" IsVisible="{Binding ShowInstallOptions}">
                            <TextBlock Text="{x:Static res:Strings.EditorServerPassword}" />
                            <TextBox Text="{Binding ServerPassword}" PasswordChar="•" />
                            <TextBlock Text="{x:Static res:Strings.EditorServerPasswordHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding RestrictKey}" Margin="0,4,0,0">
                                <TextBlock Text="{x:Static res:Strings.EditorRestrictKey}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{x:Static res:Strings.EditorRestrictKeyHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding SharedKeyWarning}" IsVisible="{Binding HasSharedKeyWarning}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{DynamicResource WarningBorder}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsUsb}">
                        <CheckBox IsChecked="{Binding PlugInEnabled}">
                            <TextBlock Text="{x:Static res:Strings.EditorPlugIn}" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding PlugInEnabled}">
                            <TextBlock Text="{x:Static res:Strings.EditorPlugInAtMost}" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding PlugInHours}" Minimum="0" Maximum="720" Increment="1" FormatString="0" Width="120" />
                            <TextBlock Text="{x:Static res:Strings.EditorPlugInHours}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Static res:Strings.EditorPlugInHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="28,0,0,0" />
                        <TextBlock Text="{x:Static res:Strings.EditorPlugInNeedsBackground}" IsVisible="{Binding PlugInNeedsBackground}"
                                   FontSize="12" Foreground="{DynamicResource WarningBorder}" TextWrapping="Wrap" Margin="28,0,0,0" />
                    </StackPanel>

                    <Expander Header="{x:Static res:Strings.EditorChecks}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Static res:Strings.EditorChecksIntro}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding CheckAfterBackup}">
                                <TextBlock Text="{x:Static res:Strings.EditorCheckAfterBackup}" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,4" IsEnabled="{Binding CheckAfterBackup}">
                                <TextBlock Text="{x:Static res:Strings.EditorCheckInterval}" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding CheckIntervalDays}" Minimum="1" Maximum="365" Increment="1" FormatString="0" Width="120" />
                                <TextBlock Text="{x:Static res:Strings.EditorCheckIntervalDays}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.EditorCheckSchedules}" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding CheckSchedules}" />
                            <Button Content="{x:Static res:Strings.JobEditorAddSchedule}" Command="{Binding AddCheckScheduleCommand}" HorizontalAlignment="Left" />
                            <CheckBox IsChecked="{Binding CheckCatchUp}" IsVisible="{Binding HasCheckSchedules}">
                                <TextBlock Text="{x:Static res:Strings.JobEditorCatchUp}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{x:Static res:Strings.EditorCheckSchedulesHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding HasCheckSchedules}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="{x:Static res:Strings.EditorAdvanced}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static res:Strings.EditorBorgVersion}" />
                            <ComboBox ItemsSource="{Binding BorgVersionOptions}" SelectedItem="{Binding SelectedBorgVersion}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="{x:Static res:Strings.EditorStorageWarn}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding StorageWarnPercent}" Minimum="0" Maximum="90" Increment="5" FormatString="0"
                                               Width="120" />
                                <TextBlock Text="%" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.EditorStorageWarnHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                            <!-- Limits -->
                            <TextBlock Text="{x:Static res:Strings.EditorLimits}" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <StackPanel Spacing="6" IsVisible="{Binding IsSsh}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox IsChecked="{Binding LimitUpload}" Content="{x:Static res:Strings.EditorUploadLimit}" VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding UploadLimit}" Minimum="0.1" Maximum="10000" Increment="1" FormatString="0.#" Width="120"
                                                   IsEnabled="{Binding LimitUpload}" />
                                    <TextBlock Text="MB/s" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="28,0,0,0" Spacing="6" IsEnabled="{Binding LimitUpload}">
                                    <CheckBox IsChecked="{Binding UploadOnlyBetween}" Content="{x:Static res:Strings.EditorUploadOnlyBetween}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" IsEnabled="{Binding UploadOnlyBetween}">
                                        <TimePicker SelectedTime="{Binding UploadFrom}" ClockIdentifier="24HourClock" MinuteIncrement="15" MinWidth="0" Width="150" />
                                        <TextBlock Text="{x:Static res:Strings.EditorUploadAnd}" VerticalAlignment="Center" />
                                        <TimePicker SelectedTime="{Binding UploadTo}" ClockIdentifier="24HourClock" MinuteIncrement="15" MinWidth="0" Width="150" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Static res:Strings.EditorUploadLimitHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.EditorUploadLimitLocal}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       IsVisible="{Binding !IsSsh}" />
                            <CheckBox IsChecked="{Binding LowPriority}">
                                <TextBlock Text="{x:Static res:Strings.EditorLowPriority}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{x:Static res:Strings.EditorLowPriorityHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                            <StackPanel Spacing="4" IsVisible="{Binding IsSsh}" Margin="0,10,0,0">
                                <TextBlock Text="{x:Static res:Strings.EditorStorageCapacity}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding StorageCapacityGigabytes}" Width="120" />
                                    <TextBlock Text="GB" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Static res:Strings.EditorStorageCapacityHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>

</Window>
