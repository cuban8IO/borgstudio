<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BorgStudio.App.ViewModels"
        xmlns:res="using:BorgStudio.App.Resources"
        x:Class="BorgStudio.App.Views.PrunePreviewWindow"
        x:DataType="vm:PrunePreviewViewModel"
        Title="{x:Static res:Strings.PruneTitle}"
        Width="640" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RulesText}" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="{x:Static res:Strings.PruneHint}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource WarningBorder}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button Content="{Binding ConfirmText}" Classes="accent" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Column headers; the widths match the rows below -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,130,150" Margin="12,0,12,4">
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
            </Grid.Styles>
            <TextBlock Text="{x:Static res:Strings.ArchiveColumnName}" />
            <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ArchiveColumnTime}" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.ArchiveColumnStatus}" Margin="8,0,0,0" />
        </Grid>

        <ListBox ItemsSource="{Binding Archives}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PruneEntryViewModel">
                    <Grid ColumnDefinitions="*,130,150" Classes.pruned="{Binding IsPruned}">
                        <Grid.Styles>
                            <Style Selector="Grid.pruned TextBlock.status">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorForeground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style Selector="Grid.pruned TextBlock.name">
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Style>
                        </Grid.Styles>
                        <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StartText}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="status" Text="{Binding StatusText}" FontSize="13" Margin="8,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</Window>
