<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BorgStudio.App.ViewModels"
        xmlns:res="using:BorgStudio.App.Resources"
        x:Class="BorgStudio.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="580" SizeToContent="Height" MaxHeight="860" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer>
    <StackPanel Margin="20" Spacing="16">

        <!-- Language -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsLanguageHeader}" FontSize="16" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="240" />
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding RestartNeeded}">
                    <TextBlock Text="{x:Static res:Strings.SettingsLanguageRestart}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="{x:Static res:Strings.SettingsRestartNow}" Command="{Binding RestartCommand}" Classes="accent" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsUpdatesHeader}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionText}" Opacity="0.8" />
                <CheckBox IsChecked="{Binding CheckForUpdates}" Content="{x:Static res:Strings.SettingsCheckForUpdates}" />
                <Button Content="{x:Static res:Strings.SettingsCheckNow}" Command="{Binding CheckForUpdatesNowCommand}" />
            </StackPanel>
        </Border>

        <!-- Scheduled backups -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsSchedules}" FontSize="16" FontWeight="SemiBold" />
                <RadioButton GroupName="ScheduleRunner" IsChecked="{Binding RunWithSystem}">
                    <TextBlock Text="{x:Static res:Strings.SettingsRunnerSystem}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton GroupName="ScheduleRunner" IsChecked="{Binding RunInBackground}">
                    <TextBlock Text="{x:Static res:Strings.SettingsRunnerBackground}" TextWrapping="Wrap" />
                </RadioButton>
                <TextBlock Text="{x:Static res:Strings.SettingsRunnerHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Restore tests -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestHeader}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestIntro}" TextWrapping="Wrap" Opacity="0.8" />
                <CheckBox IsChecked="{Binding RestoreTestEnabled}" Content="{x:Static res:Strings.SettingsRestoreTestEnabled}" />
                <StackPanel Spacing="8" IsEnabled="{Binding RestoreTestEnabled}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                        <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestTotal}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Value="{Binding RestoreTestTotalMegabytes}" Minimum="1" Maximum="1048576" Increment="100"
                                       FormatString="0" Width="140" />
                        <TextBlock Grid.Column="2" Text="MB" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.SettingsRestoreTestPerFile}" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RestoreTestFileMegabytes}" Minimum="1" Maximum="1048576"
                                       Increment="10" FormatString="0" Width="140" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="MB" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestComparison}" />
                    <RadioButton GroupName="RestoreTestComparison" IsChecked="{Binding RestoreTestSizeAndTime}">
                        <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestSizeAndTime}" TextWrapping="Wrap" />
                    </RadioButton>
                    <RadioButton GroupName="RestoreTestComparison" IsChecked="{Binding RestoreTestSizeOnly}">
                        <TextBlock Text="{x:Static res:Strings.SettingsRestoreTestSizeOnly}" TextWrapping="Wrap" />
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Incoming webhook -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.TriggerHeader}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.TriggerIntro}" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="{x:Static res:Strings.TriggerNeedsBackground}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource WarningBorder}" IsVisible="{Binding !CanUseTrigger}" />
                <CheckBox IsChecked="{Binding TriggerEnabled}" Content="{x:Static res:Strings.TriggerEnabled}" />
                <StackPanel Spacing="8" IsEnabled="{Binding TriggerEnabled}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.TriggerPort}" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding TriggerPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="140" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding TriggerAllowNetwork}">
                        <TextBlock Text="{x:Static res:Strings.TriggerAllowNetwork}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{x:Static res:Strings.TriggerNetworkWarning}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource WarningBorder}" IsVisible="{Binding TriggerAllowNetwork}" />
                    <TextBlock Text="{x:Static res:Strings.TriggerToken}" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding TriggerToken, Mode=OneWay}" PasswordChar="●" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.TriggerCopy}" Command="{Binding CopyTriggerTokenCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.TriggerNewToken}" Command="{Binding CreateTriggerTokenCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{x:Static res:Strings.TriggerUsage}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Text="{Binding TriggerExample}" TextWrapping="Wrap" FontSize="12"
                                             FontFamily="Cascadia Code, Consolas, Menlo, monospace" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.TriggerCopy}" Command="{Binding CopyTriggerExampleCommand}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
                <TextBlock Text="{Binding TriggerStatus}" TextWrapping="Wrap" FontWeight="SemiBold"
                           IsVisible="{Binding TriggerStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding TriggerMessage}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding TriggerMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- BorgStudio Servers -->
        <Border Classes="card" IsVisible="{Binding SupportsServers}">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsServersHeader}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.SettingsServersIntro}" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="{x:Static res:Strings.SettingsServersNone}" Opacity="0.7" IsVisible="{Binding HasNoPairedServers}" />
                <ItemsControl ItemsSource="{Binding PairedServers}" IsVisible="{Binding HasPairedServers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PairedServerItem">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Static res:Strings.ServerRepair}" Command="{Binding RepairCommand}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="{x:Static res:Strings.SettingsServerUnpair}" Command="{Binding UnpairCommand}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static res:Strings.ServerPairNew}" Command="{Binding PairServerCommand}" />
                <TextBlock Text="{Binding ServerMessage}" TextWrapping="Wrap"
                           IsVisible="{Binding ServerMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <!-- Vault -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.SettingsVaultHeader}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static res:Strings.SettingsVaultIntro}" TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Static res:Strings.SettingsVaultStatus}" Opacity="0.7" />
                    <TextBlock Text="{Binding VaultStatus}" FontWeight="SemiBold" />
                </StackPanel>

                <WrapPanel>
                    <WrapPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="0,0,8,8" />
                        </Style>
                    </WrapPanel.Styles>
                    <Button Content="{x:Static res:Strings.SettingsSetUpPin}" Command="{Binding SetUpPinCommand}"
                            Classes="accent" IsVisible="{Binding IsNotSetUp}" />
                    <Button Content="{x:Static res:Strings.SettingsChangePin}" Command="{Binding ChangePinCommand}"
                            IsVisible="{Binding IsSetUp}" />
                    <Button Content="{x:Static res:Strings.VaultLock}" Command="{Binding LockVaultCommand}"
                            IsVisible="{Binding IsSetUp}" />
                    <Button Content="{x:Static res:Strings.SettingsResetVault}" Command="{Binding ResetVaultCommand}"
                            IsVisible="{Binding IsSetUp}" />
                </WrapPanel>

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <CheckBox IsChecked="{Binding AutoLock}" Content="{x:Static res:Strings.SettingsAutoLock}"
                              VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding SelectedAutoLockMinutes}"
                              IsEnabled="{Binding AutoLock}" MinWidth="140" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Static res:Strings.SettingsAutoLockHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Button Content="{x:Static res:Strings.Close}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
    </StackPanel>
    </ScrollViewer>

</Window>
