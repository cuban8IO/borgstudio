<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:BorgStudio.App.Resources"
        x:Class="BorgStudio.App.Views.PinWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" />

        <TextBlock x:Name="PinLabel" Text="{x:Static res:Strings.PinLabel}" Margin="0,4,0,0" />
        <TextBox x:Name="PinBox" PasswordChar="•" />

        <StackPanel x:Name="ConfirmPanel" Spacing="10">
            <TextBlock Text="{x:Static res:Strings.PinConfirmLabel}" />
            <TextBox x:Name="ConfirmBox" PasswordChar="•" />
            <TextBlock x:Name="HintText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForeground}" IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="{x:Static res:Strings.Ok}" Classes="accent" IsDefault="True" Click="Ok_Click" />
            <Button Content="{x:Static res:Strings.Cancel}" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>

</Window>
