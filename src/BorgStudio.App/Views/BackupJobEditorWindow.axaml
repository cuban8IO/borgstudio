<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BorgStudio.App.ViewModels"
        xmlns:res="using:BorgStudio.App.Resources"
        xmlns:sys="using:System"
        x:Class="BorgStudio.App.Views.BackupJobEditorWindow"
        x:DataType="vm:BackupJobEditorViewModel"
        Title="{Binding Title}"
        Width="640" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorForeground}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="{x:Static res:Strings.EditorSave}" Command="{Binding SaveCommand}" Classes="accent" IsDefault="True" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="16" Margin="0,0,12,0">
                <TextBlock Text="{Binding RepositoryTitle}"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static res:Strings.EditorName}" />
                    <TextBox Text="{Binding Name}" />
                    <TextBlock Text="{x:Static res:Strings.JobEditorNameHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Sources -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:Strings.JobEditorSources}" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinHeight="70" MaxHeight="160" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static res:Strings.JobEditorAddSource}" Command="{Binding AddSourceCommand}" />
                        <Button Content="{x:Static res:Strings.Remove}" Command="{Binding RemoveSourceCommand}" CommandParameter="{x:Null}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningBorder}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- What to leave out -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:Strings.JobEditorExclusions}" FontWeight="SemiBold" />
                    <CheckBox IsChecked="{Binding CachesAndTemp}">
                        <TextBlock Text="{x:Static res:Strings.JobEditorCachesAndTemp}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding DevelopmentFolders}">
                        <TextBlock Text="{x:Static res:Strings.JobEditorDevelopmentFolders}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RecycleBin}">
                        <TextBlock Text="{x:Static res:Strings.JobEditorRecycleBin}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding CacheDirTag}">
                        <TextBlock Text="{x:Static res:Strings.JobEditorCacheDirTag}" TextWrapping="Wrap" />
                    </CheckBox>

                    <TextBlock Text="{x:Static res:Strings.JobEditorExtensions}" Margin="0,6,0,0" />
                    <TextBox Text="{Binding Extensions}" PlaceholderText=".iso, .tmp, .log" />

                    <TextBlock Text="{x:Static res:Strings.JobEditorExcludedFolders}" Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding ExcludedFolders}" SelectedItem="{Binding SelectedExcludedFolder}" MinHeight="50" MaxHeight="130" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static res:Strings.JobEditorAddExcludedFolder}" Command="{Binding AddExcludedFolderCommand}" />
                        <Button Content="{x:Static res:Strings.Remove}" Command="{Binding RemoveExcludedFolderCommand}" CommandParameter="{x:Null}" />
                    </StackPanel>
                </StackPanel>

                <!-- Clean-up -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:Strings.JobEditorCleanup}" FontWeight="SemiBold" />
                    <CheckBox IsChecked="{Binding CleanUp}">
                        <TextBlock Text="{x:Static res:Strings.JobEditorCleanupEnabled}" TextWrapping="Wrap" />
                    </CheckBox>
                    <StackPanel Spacing="8" IsVisible="{Binding CleanUp}" Margin="28,2,0,0">
                        <Grid ColumnDefinitions="Auto,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,0,16,6" />
                                </Style>
                                <Style Selector="NumericUpDown">
                                    <Setter Property="Minimum" Value="0" />
                                    <Setter Property="Maximum" Value="9999" />
                                    <Setter Property="Increment" Value="1" />
                                    <Setter Property="FormatString" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </Grid.Styles>
                            <TextBlock Text="{x:Static res:Strings.JobEditorKeepDaily}" />
                            <NumericUpDown Grid.Column="1" Value="{Binding KeepDaily}" />
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.JobEditorKeepWeekly}" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding KeepWeekly}" />
                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.JobEditorKeepMonthly}" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding KeepMonthly}" />
                            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.JobEditorKeepYearly}" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding KeepYearly}" />

                            <!-- Rarely needed -->
                            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.JobEditorKeepHourly}" Margin="0,8,16,6" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding KeepHourly}" Margin="0,8,0,6" />
                            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.JobEditorKeepLast}" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding KeepLast}" />
                            <TextBlock Grid.Row="6" Text="{x:Static res:Strings.JobEditorKeepWithin}" />
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding KeepWithinDays}" />
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.JobEditorCleanupHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Expander Header="{x:Static res:Strings.EditorAdvanced}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static res:Strings.JobEditorCompression}" />
                        <ComboBox ItemsSource="{Binding CompressionOptions}" SelectedItem="{Binding SelectedCompression}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="{x:Static res:Strings.JobEditorPatterns}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Patterns}" AcceptsReturn="True" MinHeight="70"
                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace" FontSize="12" />

                        <TextBlock Text="{x:Static res:Strings.JobEditorPreview}" Margin="0,6,0,0" Opacity="0.7" />
                        <Border Classes="card" Padding="8">
                            <SelectableTextBlock Text="{Binding PatternPreview}" TextWrapping="Wrap" FontSize="12"
                                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
