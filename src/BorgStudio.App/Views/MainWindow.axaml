<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BorgStudio.App.ViewModels"
        xmlns:views="using:BorgStudio.App.Views"
        xmlns:controls="using:BorgStudio.App.Controls"
        xmlns:res="using:BorgStudio.App.Resources"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BorgStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- macOS shows this in the global menu bar, Windows/Linux via the NativeMenuBar below. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{x:Static res:Strings.MenuTools}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.MenuSettings}" Click="OpenSettings_Click" />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuNotifications}" Click="OpenNotifications_Click" />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuKeys}" Click="OpenKeys_Click" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuExport}" Click="OpenExport_Click" />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuImport}" Click="OpenImport_Click" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuPlugins}" Click="OpenPlugins_Click" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{x:Static res:Strings.MenuHelp}">
                <NativeMenu>
                    <NativeMenuItem Header="{x:Static res:Strings.MenuGuide}" Click="OpenGuide_Click" />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuWebsite}" Click="OpenWebsite_Click" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuCheckForUpdates}" Click="OpenUpdate_Click" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{x:Static res:Strings.MenuAbout}" Click="OpenAbout_Click" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>
        <!-- The list of mounts is wider than a flyout normally may be. -->
        <Style Selector="FlyoutPresenter.mounts">
            <Setter Property="MaxWidth" Value="600" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockVaultCommand}" />
    </Window.KeyBindings>

    <Panel>
    <DockPanel IsVisible="{Binding IsAppVisible}">
        <NativeMenuBar DockPanel.Dock="Top" />

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource BpLineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding BorgStatus}" FontSize="12" Foreground="{DynamicResource BpTextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Running tasks: what works, waits, or runs in the task scheduler – with the time still to go -->
                    <Button FontSize="12" Padding="8,1" MinHeight="0" ToolTip.Tip="{x:Static res:Strings.TasksTip}"
                            AutomationProperties.Name="{x:Static res:Strings.TasksHeader}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H15 V19 H3 Z" Width="12" Height="12"
                                      Foreground="{DynamicResource BpTextSecondaryBrush}" IsVisible="{Binding !Tasks.IsBusy}" />
                            <PathIcon Data="M12,2 A10,10 0 1 1 2,12 H5 A7,7 0 1 0 12,5 Z" Width="12" Height="12"
                                      Foreground="{DynamicResource BpGreenBrush}" IsVisible="{Binding Tasks.IsBusy}" />
                            <TextBlock Text="{Binding Tasks.SummaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="mounts">
                                <StackPanel Spacing="8" Width="480">
                                    <TextBlock Text="{x:Static res:Strings.TasksHeader}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Static res:Strings.TasksEmpty}" Opacity="0.65" IsVisible="{Binding !Tasks.HasTasks}" />
                                    <ScrollViewer MaxHeight="420" IsVisible="{Binding Tasks.HasTasks}">
                                        <ItemsControl ItemsSource="{Binding Tasks.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RunningTaskViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding Title}" />
                                                            <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11" Opacity="0.65"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <ProgressBar IsVisible="{Binding IsRunning}" Minimum="0" Maximum="1" Value="{Binding Fraction}"
                                                                         IsIndeterminate="{Binding IsIndeterminate}" Height="4" MinHeight="4" Margin="0,3,0,1" />
                                                            <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{x:Static res:Strings.TaskShow}" Command="{Binding ShowCommand}"
                                                                IsVisible="{Binding CanShow}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}"
                                                                IsVisible="{Binding CanCancel}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Mounted archives: open or unmount them -->
                <Button Grid.Column="2" IsVisible="{Binding HasMounts}" FontSize="12" Padding="8,1" MinHeight="0" Margin="0,0,12,0"
                        ToolTip.Tip="{x:Static res:Strings.MountsTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M2,5 L9,5 L11,7 L22,7 L22,19 L2,19 Z" Width="12" Height="12"
                                  Foreground="{DynamicResource BpGreenBrush}" />
                        <TextBlock Text="{Binding MountsText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight" FlyoutPresenterClasses="mounts">
                            <StackPanel Spacing="8" Width="520">
                                <TextBlock Text="{x:Static res:Strings.MountsHeader}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Mounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MountItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                    <TextBlock Text="{Binding OpenPath}" FontSize="11" Opacity="0.65"
                                                               TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding OpenPath}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{x:Static res:Strings.MountOpen}" Command="{Binding OpenCommand}"
                                                        Margin="8,0,0,0" FontSize="12" />
                                                <Button Grid.Column="2" Content="{x:Static res:Strings.MountUnmount}" Command="{Binding UnmountCommand}"
                                                        Margin="6,0,0,0" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Static res:Strings.MountsHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.MountUnmountAll}" Command="{Binding UnmountAllMountsCommand}"
                                            Margin="8,0,0,0" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontSize="12"
                           Foreground="{DynamicResource SuccessForeground}" Margin="16,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsVaultSetUp}">
                    <TextBlock Text="{Binding VaultStatus}" FontSize="12" Foreground="{DynamicResource BpTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="{x:Static res:Strings.VaultLock}" Command="{Binding LockVaultCommand}"
                            IsVisible="{Binding IsVaultUnlocked}" FontSize="12" Padding="8,1" MinHeight="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- A new release is out -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasUpdate}" Classes="card" Margin="16,16,16,0" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <PathIcon Data="M11,3 H13 V13 L16.5,9.5 L18,11 L12,17 L6,11 L7.5,9.5 L11,13 Z M5,19 H19 V21 H5 Z" Width="16" Height="16" Margin="0,0,12,0"
                          Foreground="{DynamicResource BpGreenBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding UpdateBannerText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="{x:Static res:Strings.UpdateDetails}" Command="{Binding ShowUpdateCommand}"
                        Classes="accent" Margin="12,0,8,0" />
                <Button Grid.Column="3" Content="{x:Static res:Strings.UpdateLater}" Command="{Binding DismissUpdateCommand}" />
            </Grid>
        </Border>

        <!-- Shown when borg is missing, too old or not supported -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasBorgProblem}"
                Margin="16,16,16,0" Padding="16,12" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding BorgProblemTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BorgProblemText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="{x:Static res:Strings.CheckAgain}" Command="{Binding CheckBorgCommand}" />
                    <HyperlinkButton Content="{x:Static res:Strings.InstallationGuide}"
                                     NavigateUri="{Binding InstallationGuideUrl}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Shown when repositories.json could not be read -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding StoreWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                Margin="16,16,16,0" Padding="16,12" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}">
            <TextBlock Text="{Binding StoreWarning}" TextWrapping="Wrap" />
        </Border>

        <Grid ColumnDefinitions="280,*" Margin="0,12,0,0">

            <!-- Repository list -->
            <DockPanel Grid.Column="0" Margin="16,4,8,16">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.RepositoriesHeader}"
                           FontSize="16" FontWeight="SemiBold" Margin="4,0,0,8" />
                <Button DockPanel.Dock="Bottom" Content="{x:Static res:Strings.AddRepository}"
                        Command="{Binding AddRepositoryCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Margin="0,8,0,0" />
                <!-- The overview of all repositories, above the list -->
                <Button DockPanel.Dock="Top" Command="{Binding ShowOverviewCommand}" IsVisible="{Binding HasRepositories}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6" Padding="12,8"
                        Classes="overviewEntry" Classes.selected="{Binding IsOverviewShown}">
                    <Button.Styles>
                        <Style Selector="Button.overviewEntry">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="3,0,0,0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                        <Style Selector="Button.overviewEntry.selected">
                            <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BpGreenBrush}" />
                        </Style>
                    </Button.Styles>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Static res:Strings.DashTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static res:Strings.DashEntrySub}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Button>
                <ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding ListedRepository}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepositoryItemViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,4">
                                <Panel VerticalAlignment="Top" Margin="0,5,0,0" Width="9" Height="9">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartFailBrush}" IsVisible="{Binding StateIsCritical}" />
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartWarnBrush}" IsVisible="{Binding StateIsWarning}" />
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartOkBrush}" IsVisible="{Binding StateIsOk}" />
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource ChartTrackBrush}" IsVisible="{Binding StateIsInfo}" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProviderName}" FontSize="12" Opacity="0.7" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- No repositories yet -->
            <StackPanel Grid.Column="1" IsVisible="{Binding !HasRepositories}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Spacing="10">
                <TextBlock Text="{x:Static res:Strings.Welcome}" FontSize="24" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static res:Strings.NoRepositoriesText}" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" />
                <Button Content="{x:Static res:Strings.AddRepository}" Command="{Binding AddRepositoryCommand}"
                        Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <!-- The overview of all repositories -->
            <ScrollViewer Grid.Column="1" IsVisible="{Binding ShowsOverview}">
                <StackPanel Spacing="14" Margin="16,4,24,16" DataContext="{Binding Dashboard}" x:DataType="vm:DashboardViewModel">
                    <StackPanel.Styles>
                        <Style Selector="Border.tile">
                            <Setter Property="Background" Value="{DynamicResource BpSurface2Brush}" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="MinWidth" Value="170" />
                        </Style>
                        <Style Selector="TextBlock.tileLabel">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Style>
                        <Style Selector="TextBlock.tileValue">
                            <Setter Property="FontSize" Value="22" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style Selector="TextBlock.tileSub">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Style>
                        <Style Selector="Ellipse.dot">
                            <Setter Property="Width" Value="10" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style Selector="Border.swatch">
                            <Setter Property="Width" Value="10" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="CornerRadius" Value="2" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,5,0" />
                        </Style>
                    </StackPanel.Styles>

                    <TextBlock Text="{x:Static res:Strings.DashTitle}" FontSize="22" FontWeight="SemiBold" />

                    <!-- Key figures -->
                    <WrapPanel>
                        <Border Classes="tile">
                            <StackPanel>
                                <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.DashStored}" />
                                <TextBlock Classes="tileValue" Text="{Binding StoredText}" />
                                <TextBlock Classes="tileSub" Text="{Binding RepositoriesText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel>
                                <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.DashSavings}" />
                                <TextBlock Classes="tileValue" Text="{Binding SavingsText}" />
                                <TextBlock Classes="tileSub" Text="{Binding SavingsDetailText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel>
                                <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsSuccessRate}" />
                                <TextBlock Classes="tileValue" Text="{Binding SuccessRateText}" />
                                <TextBlock Classes="tileSub" Text="{Binding SuccessDetailText}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel>
                                <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.DashEarliestFull}" />
                                <TextBlock Classes="tileValue" Text="{Binding EarliestFullText}" Classes.soon="{Binding IsFullSoon}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock.soon">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Classes="tileSub" Text="{Binding EarliestFullDetailText}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Repositories, problems first -->
                    <Border Classes="card">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Static res:Strings.DashRepositoriesTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardRowViewModel">
                                        <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="8,8"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                ToolTip.Tip="{x:Static res:Strings.DashOpenTip}">
                                            <Grid ColumnDefinitions="Auto,*,240" ColumnSpacing="12">
                                                <Panel VerticalAlignment="Top" Margin="0,5,0,0">
                                                    <Ellipse Classes="dot" Fill="{DynamicResource ChartFailBrush}" IsVisible="{Binding IsCritical}" />
                                                    <Ellipse Classes="dot" Fill="{DynamicResource ChartWarnBrush}" IsVisible="{Binding IsWarning}" />
                                                    <Ellipse Classes="dot" Fill="{DynamicResource ChartOkBrush}" IsVisible="{Binding IsOk}" />
                                                    <Ellipse Classes="dot" Fill="{DynamicResource ChartTrackBrush}" IsVisible="{Binding IsInfo}" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding HealthText}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                                                    <ItemsControl ItemsSource="{Binding Statuses}" Margin="0,2,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DashboardStatus">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Panel Width="7" Height="7" VerticalAlignment="Center">
                                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ChartFailBrush}" IsVisible="{Binding IsCritical}" />
                                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ChartWarnBrush}" IsVisible="{Binding IsWarning}" />
                                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ChartOkBrush}" IsVisible="{Binding IsOk}" />
                                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ChartTrackBrush}" IsVisible="{Binding IsInfo}" />
                                                                    </Panel>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.6" Width="140" />
                                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                    <controls:StackedBar Segments="{Binding Item.StorageSegments}" Height="10"
                                                                         IsVisible="{Binding Item.HasStorageBar}" />
                                                    <TextBlock Text="{Binding StorageText}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding FullText}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasFullText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Activity of all jobs -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Static res:Strings.DashActivityTitle}" FontWeight="SemiBold" />
                            <controls:ActivityCalendar Days="{Binding Days}" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="{DynamicResource ChartOkBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.StatsLegendOk}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="{DynamicResource ChartWarnBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.StatsLegendWarnings}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="{DynamicResource ChartFailBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.StatsLegendFailed}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Classes="swatch" Background="{DynamicResource ChartTrackBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.StatsLegendNone}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Details of the selected repository, in tabs -->
            <DockPanel Grid.Column="1" IsVisible="{Binding ShowsRepository}" Margin="16,4,24,16">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
                    <TextBlock Text="{Binding SelectedRepository.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedRepository.ProviderName}" Opacity="0.7" />
                </StackPanel>

                <TabControl Padding="0" SelectedIndex="{Binding SelectedDetailsTab}">
                    <TabItem Header="{x:Static res:Strings.TabOverview}">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <Grid.Styles>
                                        <Style Selector="TextBlock.label">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Setter Property="Margin" Value="0,0,16,8" />
                                        </Style>
                                        <Style Selector="SelectableTextBlock">
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </Grid.Styles>
                                    <TextBlock Classes="label" Text="{x:Static res:Strings.LabelLocation}" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding SelectedRepository.LocationText}" />
                                    <TextBlock Grid.Row="1" Classes="label" Text="{x:Static res:Strings.LabelEncryption}" />
                                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRepository.EncryptionText}" />
                                    <TextBlock Grid.Row="2" Classes="label" Text="{x:Static res:Strings.LabelPassphrase}" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRepository.PassphraseText}" />
                                    <TextBlock Grid.Row="3" Classes="label" Text="{x:Static res:Strings.LabelBorgVersion}" />
                                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRepository.BorgVersionText}" />
                                    <TextBlock Grid.Row="4" Classes="label" Text="{x:Static res:Strings.LabelSshKey}"
                                               IsVisible="{Binding SelectedRepository.IsSsh}" />
                                    <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRepository.SshKeyText}"
                                                         IsVisible="{Binding SelectedRepository.IsSsh}" />
                                </Grid>

                                <!-- Storage -->
                                <Border Classes="card">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Static res:Strings.StorageHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{x:Static res:Strings.StorageMeasure}"
                                                    Command="{Binding MeasureStorageCommand}" />
                                        </Grid>
                                        <controls:StackedBar Segments="{Binding SelectedRepository.StorageSegments}" Height="12" Margin="0,2,0,0"
                                                             IsVisible="{Binding SelectedRepository.HasStorageBar}" />
                                        <!-- Legend: the repository, other data on the same disk, free space. -->
                                        <WrapPanel IsVisible="{Binding SelectedRepository.HasStorageBar}">
                                            <WrapPanel.Styles>
                                                <Style Selector="StackPanel.legend">
                                                    <Setter Property="Orientation" Value="Horizontal" />
                                                    <Setter Property="Spacing" Value="6" />
                                                    <Setter Property="Margin" Value="0,0,18,2" />
                                                </Style>
                                                <Style Selector="Border.swatch">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Height" Value="10" />
                                                    <Setter Property="CornerRadius" Value="2" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </WrapPanel.Styles>
                                            <StackPanel Classes="legend">
                                                <Border Classes="swatch" Background="{DynamicResource ChartSeriesBrush}" />
                                                <TextBlock Text="{Binding SelectedRepository.StorageRepositoryText}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Classes="legend" IsVisible="{Binding SelectedRepository.HasStorageSplit}">
                                                <Border Classes="swatch" Background="{DynamicResource ChartForecastBrush}" />
                                                <TextBlock Text="{Binding SelectedRepository.StorageOtherText}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Classes="legend">
                                                <Border Classes="swatch" Background="{DynamicResource ChartTrackBrush}" BorderBrush="{DynamicResource BpLineBrush}" BorderThickness="1" />
                                                <TextBlock Text="{Binding SelectedRepository.StorageFreeText}" FontSize="12" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SelectedRepository.StorageText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding !SelectedRepository.HasStorageBar}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageForecastText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedRepository.HasStorageForecast}"
                                                   Classes.soon="{Binding SelectedRepository.IsForecastSoon}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.soon">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                                </Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedRepository.StorageForecastNote}" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                                                   IsVisible="{Binding SelectedRepository.HasStorageForecastNote}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageRatiosText}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                                                   IsVisible="{Binding SelectedRepository.HasStorageRatios}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageLevelText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedRepository.IsStorageLow}" Foreground="{DynamicResource WarningBorder}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageLevelText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedRepository.IsStorageFull}" Foreground="{DynamicResource ErrorForeground}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageHint}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                                                   IsVisible="{Binding SelectedRepository.HasStorageHint}" />
                                        <TextBlock Text="{Binding SelectedRepository.StorageMeasuredText}" FontSize="12" Opacity="0.6"
                                                   IsVisible="{Binding SelectedRepository.HasStorage}" />
                                    </StackPanel>
                                </Border>

                                <!-- Integrity check -->
                                <Border Classes="card">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Static res:Strings.CheckHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="{x:Static res:Strings.CheckRun}" Command="{Binding CheckRepositoryCommand}"
                                                        ToolTip.Tip="{x:Static res:Strings.CheckRunTip}" />
                                                <Button Content="{x:Static res:Strings.CheckRunFull}" Command="{Binding CheckRepositoryFullCommand}"
                                                        ToolTip.Tip="{x:Static res:Strings.CheckRunFullTip}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Panel VerticalAlignment="Center" IsVisible="{Binding SelectedRepository.LastVerdict, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource ChartOkBrush}"
                                                         IsVisible="{Binding SelectedRepository.IsCheckOk}" />
                                                <Ellipse Width="10" Height="10" Fill="{DynamicResource ChartFailBrush}"
                                                         IsVisible="{Binding SelectedRepository.HasCheckProblems}" />
                                            </Panel>
                                            <TextBlock Text="{Binding SelectedRepository.CheckStateText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedRepository.CheckDetailText}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="{Binding SelectedRepository.CheckAttemptText}" TextWrapping="Wrap" FontSize="12"
                                                   IsVisible="{Binding SelectedRepository.HasCheckAttempt}" Foreground="{DynamicResource WarningBorder}" />
                                        <TextBlock Text="{Binding SelectedRepository.CheckHealthText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding SelectedRepository.HasCheckHealthText}" Foreground="{DynamicResource WarningBorder}" />
                                        <TextBlock Text="{Binding SelectedRepository.CheckPlanText}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                                        <StackPanel Spacing="8" IsVisible="{Binding SelectedRepository.HasCheckProblems}">
                                            <TextBlock Text="{x:Static res:Strings.CheckProblemsHint}" TextWrapping="Wrap" />
                                            <Button Content="{x:Static res:Strings.Repair}" Command="{Binding RepairRepositoryCommand}"
                                                    ToolTip.Tip="{x:Static res:Strings.RepairTip}" />
                                        </StackPanel>
                                        <Expander Header="{Binding SelectedRepository.CheckMessagesHeader}" HorizontalAlignment="Stretch"
                                                  IsVisible="{Binding SelectedRepository.HasCheckMessages}">
                                            <ScrollViewer MaxHeight="220">
                                                <ItemsControl ItemsSource="{Binding SelectedRepository.CheckMessages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sys:String">
                                                            <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace" Margin="0,0,0,4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <Border IsVisible="{Binding SelectedRepository.IsKeyfile}" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}">
                                    <TextBlock Text="{x:Static res:Strings.KeyfileWarning}" TextWrapping="Wrap" />
                                </Border>

                                <WrapPanel>
                                    <WrapPanel.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                        </Style>
                                    </WrapPanel.Styles>
                                    <Button Content="{x:Static res:Strings.TestConnection}" Command="{Binding TestRepositoryCommand}" Classes="accent" />
                                    <Button Content="{x:Static res:Strings.ExportKey}" Command="{Binding ExportKeyCommand}" />
                                    <Button Content="{x:Static res:Strings.FreeSpace}" Command="{Binding FreeSpaceCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.FreeSpaceTip}" />
                                    <Button Content="{x:Static res:Strings.BreakLock}" Command="{Binding BreakLockCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.BreakLockTip}" IsVisible="{Binding SelectedRepository.IsLocked}" />
                                    <Button Content="{x:Static res:Strings.Edit}" Command="{Binding EditRepositoryCommand}" />
                                    <Button Content="{x:Static res:Strings.Remove}" Command="{Binding RemoveRepositoryCommand}" />
                                </WrapPanel>

                                <Panel IsVisible="{Binding IsWorking}">
                                    <views:ProgressPanel DataContext="{Binding Work}" />
                                </Panel>

                                <TextBlock Text="{Binding SelectedRepository.ResultText}" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedRepository.HasSuccess}" Foreground="{DynamicResource SuccessForeground}" />
                                <TextBlock Text="{Binding SelectedRepository.ResultText}" TextWrapping="Wrap"
                                           IsVisible="{Binding SelectedRepository.HasError}" Foreground="{DynamicResource ErrorForeground}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{x:Static res:Strings.TabJobs}">
                        <DockPanel Margin="0,12,0,0">
                            <WrapPanel DockPanel.Dock="Top">
                                <WrapPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </Style>
                                </WrapPanel.Styles>
                                <Button Content="{x:Static res:Strings.JobRun}" Command="{Binding RunJobCommand}" Classes="accent" />
                                <Button Content="{x:Static res:Strings.JobCleanUp}" Command="{Binding CleanUpJobCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.JobCleanUpTip}" />
                                <Button Content="{x:Static res:Strings.JobTestRestore}" Command="{Binding TestRestoreCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.JobTestRestoreTip}" />
                                <Button Content="{x:Static res:Strings.JobNew}" Command="{Binding NewJobCommand}" />
                                <Button Content="{x:Static res:Strings.Edit}" Command="{Binding EditJobCommand}" />
                                <Button Content="{x:Static res:Strings.Delete}" Command="{Binding DeleteJobCommand}" />
                            </WrapPanel>

                            <!-- The running (or last) backup -->
                            <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" IsVisible="{Binding HasBackupRun}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding CurrentBackup.Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentBackup.StatusText}" FontSize="12" Opacity="0.8" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelBackupCommand}"
                                                IsVisible="{Binding IsBackupRunning}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding CurrentBackup.Fraction}"
                                                 IsIndeterminate="{Binding CurrentBackup.IsIndeterminate}"
                                                 IsVisible="{Binding CurrentBackup.IsBackupPhase}" />
                                    <Panel IsVisible="{Binding CurrentBackup.IsCleanupPhase}">
                                        <views:ProgressPanel DataContext="{Binding CurrentBackup.PhaseProgress}" />
                                    </Panel>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding CurrentBackup.IsBackupPhase}">
                                        <Grid.Styles>
                                            <Style Selector="TextBlock">
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Margin" Value="0,0,16,4" />
                                            </Style>
                                            <Style Selector="TextBlock.label">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </Style>
                                        </Grid.Styles>
                                        <TextBlock Classes="label" Text="{x:Static res:Strings.BackupLabelProcessed}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentBackup.ProcessedText}" />
                                        <TextBlock Grid.Row="1" Classes="label" Text="{x:Static res:Strings.BackupLabelUpload}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBackup.UploadText}" />
                                        <TextBlock Grid.Row="2" Classes="label" Text="{x:Static res:Strings.BackupLabelElapsed}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentBackup.ElapsedText}" />
                                        <TextBlock Grid.Row="3" Classes="label" Text="{x:Static res:Strings.BackupLabelRemaining}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentBackup.RemainingText}" />
                                        <TextBlock Grid.Row="4" Classes="label" Text="{x:Static res:Strings.BackupLabelCurrent}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentBackup.CurrentPath}"
                                                   TextTrimming="LeadingCharacterEllipsis" />
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding CurrentBackup.ResultText}" TextWrapping="Wrap"
                                                         IsVisible="{Binding CurrentBackup.HasResult}" />
                                    <ItemsControl ItemsSource="{Binding CurrentBackup.WarningsShown}" IsVisible="{Binding CurrentBackup.HasWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                                     Foreground="{DynamicResource WarningBorder}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Panel>
                                <ListBox ItemsSource="{Binding RepositoryJobs}" SelectedItem="{Binding SelectedJob}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackupJobItemViewModel">
                                            <StackPanel Spacing="2" Margin="2,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SourcesText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding RetentionText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ScheduleText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding ScheduleText}" />
                                                <TextBlock Text="{Binding ConditionsText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasConditions}" />
                                                <TextBlock Text="{Binding RestoreTestText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasRestoreTest}" Classes.failed="{Binding RestoreTestFailed}"
                                                           Classes.warned="{Binding RestoreTestNotRun}">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock.failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorForeground}" />
                                                        </Style>
                                                        <Style Selector="TextBlock.warned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LastRunText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                                           Classes.failed="{Binding LastRunFailed}" Classes.warned="{Binding LastRunWarned}">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock.failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorForeground}" />
                                                        </Style>
                                                        <Style Selector="TextBlock.warned">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBorder}" />
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{x:Static res:Strings.JobsEmpty}" IsVisible="{Binding !HasRepositoryJobs}"
                                           TextWrapping="Wrap" Opacity="0.7" Margin="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                            </Panel>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{x:Static res:Strings.TabArchives}">
                        <DockPanel Margin="0,12,0,0">
                            <WrapPanel DockPanel.Dock="Top">
                                <WrapPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </Style>
                                </WrapPanel.Styles>
                                <Button Content="{x:Static res:Strings.ArchiveOpen}" Command="{Binding OpenArchiveCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchiveOpenTip}" Classes="accent" />
                                <Button Content="{x:Static res:Strings.ArchivesSearch}" Command="{Binding SearchArchivesCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchivesSearchTip}" />
                                <Button Content="{x:Static res:Strings.ArchivesCompare}" Command="{Binding CompareArchivesCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchivesCompareTip}" />
                                <Button Content="{x:Static res:Strings.ArchivesComparePrevious}" Command="{Binding CompareWithPreviousCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchivesComparePreviousTip}" />
                                <Button Content="{x:Static res:Strings.ArchiveManage}" ToolTip.Tip="{x:Static res:Strings.ArchiveManageTip}">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="{x:Static res:Strings.ArchiveExport}" Command="{Binding ExportArchiveCommand}"
                                                      ToolTip.Tip="{x:Static res:Strings.ArchiveExportTip}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static res:Strings.ArchiveRename}" Command="{Binding RenameArchiveCommand}" />
                                            <MenuItem Header="{x:Static res:Strings.ArchiveComment}" Command="{Binding CommentArchiveCommand}"
                                                      ToolTip.Tip="{x:Static res:Strings.ArchiveCommentTip}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static res:Strings.ArchiveKeep}" Command="{Binding KeepArchivesCommand}"
                                                      ToolTip.Tip="{x:Static res:Strings.ArchiveKeepTip}" />
                                            <MenuItem Header="{x:Static res:Strings.ArchiveRelease}" Command="{Binding ReleaseArchivesCommand}"
                                                      ToolTip.Tip="{x:Static res:Strings.ArchiveReleaseTip}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static res:Strings.ArchiveDelete}" Command="{Binding DeleteArchivesCommand}"
                                                      ToolTip.Tip="{x:Static res:Strings.ArchiveDeleteTip}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="{x:Static res:Strings.ArchiveMount}" Command="{Binding MountArchiveCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchiveMountTip}" />
                                <Button Content="{x:Static res:Strings.ArchivesMountAll}" Command="{Binding MountRepositoryCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchivesMountAllTip}" />
                                <Button Content="{x:Static res:Strings.ArchivesRefresh}" Command="{Binding RefreshArchivesCommand}"
                                        ToolTip.Tip="{x:Static res:Strings.ArchivesRefreshTip}" />
                                <Button Content="{x:Static res:Strings.ArchivesLoadMore}" Command="{Binding LoadMoreArchiveDetailsCommand}" />
                            </WrapPanel>

                            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                                <Panel IsVisible="{Binding IsLoadingArchives}">
                                    <views:ProgressPanel DataContext="{Binding ArchivesProgress}" />
                                </Panel>
                                <Panel IsVisible="{Binding IsMounting}">
                                    <views:ProgressPanel DataContext="{Binding MountProgress}" />
                                </Panel>
                                <TextBlock Text="{Binding ArchivesStatus}" IsVisible="{Binding HasArchivesStatus}" FontSize="12" Opacity="0.8" />
                                <SelectableTextBlock Text="{Binding ArchivesError}" IsVisible="{Binding HasArchivesError}" TextWrapping="Wrap"
                                                     Foreground="{DynamicResource ErrorForeground}" />
                            </StackPanel>

                            <!-- Column headers; the widths match the rows below -->
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,130,80,90,90,80" Margin="12,0,12,4">
                                <Grid.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Opacity" Value="0.7" />
                                    </Style>
                                    <Style Selector="TextBlock.number">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </Grid.Styles>
                                <TextBlock Text="{x:Static res:Strings.ArchiveColumnName}" />
                                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ArchiveColumnTime}" Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" Classes="number" Text="{x:Static res:Strings.ArchiveColumnDuration}" />
                                <TextBlock Grid.Column="3" Classes="number" Text="{x:Static res:Strings.ArchiveColumnSize}"
                                           ToolTip.Tip="{x:Static res:Strings.ArchiveColumnSizeTip}" />
                                <TextBlock Grid.Column="4" Classes="number" Text="{x:Static res:Strings.ArchiveColumnNew}"
                                           ToolTip.Tip="{x:Static res:Strings.ArchiveColumnNewTip}" />
                                <TextBlock Grid.Column="5" Classes="number" Text="{x:Static res:Strings.ArchiveColumnFiles}" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                                     SelectedItems="{Binding SelectedArchives}" SelectionMode="Multiple"
                                     DoubleTapped="Archives_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArchiveItemViewModel">
                                        <Grid ColumnDefinitions="*,130,80,90,90,80">
                                            <Grid.Styles>
                                                <Style Selector="TextBlock.number">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="13" />
                                                </Style>
                                            </Grid.Styles>
                                            <StackPanel Spacing="2" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <WrapPanel>
                                                    <WrapPanel.Styles>
                                                        <Style Selector="WrapPanel > Border">
                                                            <Setter Property="Margin" Value="0,2,6,0" />
                                                        </Style>
                                                    </WrapPanel.Styles>
                                                    <Border Padding="5,0" CornerRadius="3" Background="{DynamicResource ChartOkBrush}" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsKept}" ToolTip.Tip="{x:Static res:Strings.ArchiveKeptTip}">
                                                        <TextBlock Text="{x:Static res:Strings.ArchiveKept}" FontSize="11" />
                                                    </Border>
                                                    <Border Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ChartOkBrush}" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsChecked}" ToolTip.Tip="{Binding CheckBadgeTip}">
                                                        <TextBlock Text="{Binding CheckBadgeText}" FontSize="11" Foreground="{DynamicResource ChartOkBrush}" />
                                                    </Border>
                                                    <Border Padding="5,0" CornerRadius="3" Background="{DynamicResource ChartFailBrush}" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsCheckDamaged}" ToolTip.Tip="{Binding CheckBadgeTip}">
                                                        <TextBlock Text="{x:Static res:Strings.ArchiveCheckDamaged}" FontSize="11" />
                                                    </Border>
                                                    <Border Padding="5,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ChartOkBrush}" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsRestoreTested}" ToolTip.Tip="{Binding RestoreBadgeTip}">
                                                        <TextBlock Text="{x:Static res:Strings.ArchiveRestoreTested}" FontSize="11" Foreground="{DynamicResource ChartOkBrush}" />
                                                    </Border>
                                                    <Border Padding="5,0" CornerRadius="3" Background="{DynamicResource ChartFailBrush}" VerticalAlignment="Center"
                                                            IsVisible="{Binding IsRestoreTestFailed}" ToolTip.Tip="{Binding RestoreBadgeTip}">
                                                        <TextBlock Text="{x:Static res:Strings.ArchiveRestoreTestFailed}" FontSize="11" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding JobText}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Comment}" FontSize="12" FontStyle="Italic" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding HasComment}" ToolTip.Tip="{Binding Comment}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StartText}" VerticalAlignment="Center" FontSize="13" Margin="8,0,0,0" />
                                            <TextBlock Grid.Column="2" Classes="number" Text="{Binding DurationText}" />
                                            <TextBlock Grid.Column="3" Classes="number" Text="{Binding OriginalText}" />
                                            <TextBlock Grid.Column="4" Classes="number" Text="{Binding NewText}" />
                                            <TextBlock Grid.Column="5" Classes="number" Text="{Binding FilesText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="{x:Static res:Strings.TabStatistics}">
                        <ScrollViewer>
                            <StackPanel Spacing="14" Margin="0,12,12,0" DataContext="{Binding Statistics}" x:DataType="vm:RepositoryStatisticsViewModel">
                                <StackPanel.Styles>
                                    <Style Selector="Border.tile">
                                        <Setter Property="Background" Value="{DynamicResource BpSurface2Brush}" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                        <Setter Property="MinWidth" Value="150" />
                                    </Style>
                                    <Style Selector="TextBlock.tileLabel">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Opacity" Value="0.7" />
                                    </Style>
                                    <Style Selector="TextBlock.tileValue">
                                        <Setter Property="FontSize" Value="20" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                    <Style Selector="TextBlock.tileSub">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </Style>
                                    <Style Selector="TextBlock.cardTitle">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </StackPanel.Styles>

                                <!-- Storage over time -->
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.StatsStorageTitle}" />
                                        <controls:StorageChart Height="200" Points="{Binding StoragePoints}" Projection="{Binding Projection}"
                                                               Limit="{Binding Limit}" LimitLabel="{Binding LimitLabel}"
                                                               IsVisible="{Binding HasStorageChart}" />
                                        <TextBlock Text="{x:Static res:Strings.StatsStorageEmpty}" TextWrapping="Wrap" Opacity="0.7"
                                                   IsVisible="{Binding !HasStorageChart}" />
                                        <TextBlock Text="{Binding ForecastText}" TextWrapping="Wrap" IsVisible="{Binding HasForecast}" />
                                    </StackPanel>
                                </Border>

                                <!-- What deduplication and compression save -->
                                <Border Classes="card" IsVisible="{Binding HasStats}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.StatsSavingsTitle}" />
                                        <WrapPanel>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsOriginal}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding OriginalText}" />
                                                    <TextBlock Classes="tileSub" Text="{Binding ArchivesText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsStored}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding StoredText}" />
                                                    <TextBlock Classes="tileSub" Text="{Binding SavingsText, StringFormat={x:Static res:Strings.StatsSavedFormat}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsDeduplication}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding DeduplicationText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsCompression}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding CompressionText}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Backups -->
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.StatsBackupsTitle}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding JobOptions}" SelectedItem="{Binding SelectedJob}" MinWidth="180" />
                                        </Grid>
                                        <WrapPanel>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsSuccessRate}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding SuccessRateText}" />
                                                    <TextBlock Classes="tileSub" Text="{Binding SuccessDetailText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsLastSuccess}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding LastSuccessText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsAverageDuration}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding AverageDurationText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="tile">
                                                <StackPanel>
                                                    <TextBlock Classes="tileLabel" Text="{x:Static res:Strings.StatsAverageNew}" />
                                                    <TextBlock Classes="tileValue" Text="{Binding AverageNewText}" />
                                                    <TextBlock Classes="tileSub" Text="{Binding NewPerWeekText, StringFormat={x:Static res:Strings.StatsWeekFormat}}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{x:Static res:Strings.StatsColumnsTitle}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasColumns}" />
                                        <controls:ColumnChart Height="170" Columns="{Binding Columns}" IsVisible="{Binding HasColumns}" />
                                        <TextBlock Text="{x:Static res:Strings.StatsNoRuns}" Opacity="0.7" IsVisible="{Binding !HasColumns}" />
                                    </StackPanel>
                                </Border>

                                <!-- Activity -->
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.StatsActivityTitle}" />
                                        <controls:ActivityCalendar Days="{Binding Days}" HorizontalAlignment="Left" />
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <StackPanel.Styles>
                                                <Style Selector="Border.swatch">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Height" Value="10" />
                                                    <Setter Property="CornerRadius" Value="2" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Margin" Value="0,0,5,0" />
                                                </Style>
                                            </StackPanel.Styles>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Classes="swatch" Background="{DynamicResource ChartOkBrush}" />
                                                <TextBlock Text="{x:Static res:Strings.StatsLegendOk}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Classes="swatch" Background="{DynamicResource ChartWarnBrush}" />
                                                <TextBlock Text="{x:Static res:Strings.StatsLegendWarnings}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Classes="swatch" Background="{DynamicResource ChartFailBrush}" />
                                                <TextBlock Text="{x:Static res:Strings.StatsLegendFailed}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Classes="swatch" Background="{DynamicResource ChartTrackBrush}" />
                                                <TextBlock Text="{x:Static res:Strings.StatsLegendNone}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>

    <!-- Lock screen: with a PIN set up, nothing of the app is shown until it is unlocked. -->
    <Border IsVisible="{Binding IsLocked}" Background="{DynamicResource BpBgBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Spacing="12">
            <Image Source="/Assets/borgstudio.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="{x:Static res:Strings.LockScreenTitle}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.LockScreenText}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource BpTextSecondaryBrush}" />
            <TextBox x:Name="LockScreenPinBox" Text="{Binding LockScreenPin}" PasswordChar="•"
                     PlaceholderText="{x:Static res:Strings.PinLabel}" Margin="0,8,0,0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Content="{x:Static res:Strings.Unlock}" Command="{Binding UnlockCommand}" Classes="accent"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsUnlocking}" />
            <TextBlock Text="{Binding LockScreenError}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource ErrorForeground}"
                       IsVisible="{Binding LockScreenError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <HyperlinkButton Content="{x:Static res:Strings.ForgotPin}" Command="{Binding ForgotPinCommand}"
                             HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Panel>

</Window>
